# WARNING: this file is an example, please change any insecure tokens, password, ..etc with a
#          secure and safe one. If you running SS3 for the first time please cat this file to ".env"
#          and modify the valuse if needed. If you are a developer make sure to not set any
#          sensitive data in this file because it will be pushed.


# SS3 prot that will run on.
SS3_PORT=3000

# Database host, we use PostgreSQL as the main database.
SS3_DB_URL=postgresql://localhost:5432/secure_s3
# Database username, make sure to make a user in your main database and to give it the permissions
#   to manage the ss3_* tables.
SS3_DB_USERNAME=secure_s3
# Database user password.
SS3_DB_PASSWORD=Password123
# Database max pool connection size, you need to calculate how much traffic you will receive and
#   how much resources you have.
SS3_DB_MAX_POOL_SIZE=20
# Datatbase min idle connection.
SS3_DB_MIN_IDLE=10

# Openbao ULR, make sure to allow the SS3 connection to Openbao if you running it in DMZ.
SS3_OPENBAO_URL=http://localhost:8200
# Openbao root token, you will get this token when you initialize the Openbao for the first time.
#
# NOTE: This token must start with "s." and to be like this "s.<token>".
SS3_OPENBAO_ROOT_TOKEN=
# Openbao key name, you need to create a KEK and to set its name here.
SS3_OPENBAO_KEK_NAME=ss3

# Rustfs URL.
SS3_RUSTFS_URL=http://localhost:9000
# Rustfs access key, make sure to config Rustfs and to set a strong key.
SS3_RUSTFS_ACCESS_KEY=your_strong_access_key
# Rustfs secret key, make sure to config Rustfs and to set a strong key.
SS3_RUSTFS_SECRET_KEY=your_strong_secret_key
# Rustfs bucket name, make sure to go to the web shell and to create a new bucket, after that set
#   the bucket name here.
SS3_RUSTFS_BUCKET_NAME=ss3
# Rustfs region, for local use keep it as it is.
SS3_RUSTFS_REGION=us-east-1

# Redis host, make sure to allow the SS3 connection to Redis if you running it in DMZ.
SS3_REDIS_HOST=http://localhost
# Redis port, by default it will be 6379.
SS3_REDIS_PORT=6379
# Redis password, make sure to set and config the password, you can use Redis without password but
#   we do not recommend it.
SS3_REDIS_PASSWORD=Password123
# Redis timeoute, set this as you need. NOTE: this will drop the Redis connection if it tome out.
SS3_REDIS_TIMEOUTE=2000ms
# Redis max connection pool size, set this base on your need and resources.
SS3_REDIS_POOL_MAX_ACTIVE=8
# Redis max idle connection.
SS3_REDIS_POOL_MAX_IDLE=8
# Redis min idle connection.
SS3_REDIS_POOL_MIN_IDLE=2

# SS3 session ttl, set this base in your session staregy, NOTE: this value is in minutes.
SS3_SESSION_REDIS_TTL_MINUTES=60
# SS3 min file size, it will return an error to your main system when it tries to create a file
#   less than this value.
SS3_MIN_FILE_SIZE_BYTES=1024
# SS3 max file size, it will return an error to your main system when it tries to create a file
#   greater than this value.
SS3_MAX_FILE_SIZE_BYTES=10737418240
# SS3 max chunk size, this value uses to create the file chunk structre, less size with large file
#   size will create a lot of chunk. You can calculate this with this formula:
#   SS3_MAX_FILE_SIZE_BYTES / SS3_CHUNK_MAX_SIZE_BYTES = Number of chunks per max file size.
SS3_CHUNK_MAX_SIZE_BYTES=10485760
# SS3 file allowed extensions, this value use to prevent other systems managing and create session
#   from creating unallowed files.
#
# NOTE: this vaule must be separated by "," and every value must not have a special character, if
#       you have only one file type you can set it like this: SS3_FILE_EXTENSIONS=pdf
SS3_FILE_EXTENSIONS=pdf,png,docx,doc
